{
  "manifest_version": 3,
  "name": "RelayStudio Web Bridge",
  "version": "1.5.0",
  "description": "RelayStudio multi-platform web conversation bridge",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "icons": {
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "bridge-page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "bridge-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
